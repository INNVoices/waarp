diff --git a/conn/bind_std.go b/conn/bind_std.go
--- a/conn/bind_std.go
+++ b/conn/bind_std.go
@@ -569,6 +569,10 @@
 	} else {
 		for i := range bufs {
 			(*msgs)[i].Addr = ua
+			// A failed GSO attempt can leave several datagrams in one message.
+			// Ordinary UDP must send exactly one buffer per datagram.
+			clear((*msgs)[i].Buffers[1:])
+			(*msgs)[i].Buffers = (*msgs)[i].Buffers[:1]
 			(*msgs)[i].Buffers[0] = bufs[i][offset:]
 			setSrcControl(&(*msgs)[i].OOB, standardEndpoint)
 		}
diff --git a/conn/errors_linux.go b/conn/errors_linux.go
--- a/conn/errors_linux.go
+++ b/conn/errors_linux.go
@@ -20,7 +20,9 @@
 		// See:
 		// https://git.kernel.org/pub/scm/docs/man-pages/man-pages.git/tree/man7/udp.7?id=806eabd74910447f21005160e90957bde4db0183#n228
 		// https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/tree/net/ipv4/udp.c?h=v6.2&id=c9c3395d5e3dcc6daee66c6908354d47bf98cb0c#n942
-		return serr.Err == unix.EIO
+		// EINVAL can be returned when the GSO size plus UDP/IP headers is
+		// larger than the path's fragment size.
+		return serr.Err == unix.EIO || serr.Err == unix.EINVAL
 	}
 	return false
 }
