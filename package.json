{
  "name": "waarp",
  "productName": "Waarp",
  "version": "0.4.1-rc.2",
  "license": "Apache-2.0",
  "private": true,
  "description": "Windows per-app and per-site traffic router with stable Auto paths and multi-protocol tunnels",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "dist": "npm run engine:verify && npm run build && electron-builder --win --publish never",
    "pack": "npm run engine:verify && npm run build && electron-builder --win dir",
    "check": "node scripts/check-modules.mjs && node scripts/check-raw-ui.mjs && node scripts/check-icons.mjs && node scripts/check-strings.mjs",
    "test:live": "node scripts/test-live.mjs",
    "engine:fetch": "node scripts/engine.mjs fetch",
    "engine:verify": "node scripts/engine.mjs verify",
    "android:build": "node scripts/android-build.mjs",
    "android:core:fetch": "node scripts/android-core.mjs fetch",
    "android:core:verify": "node scripts/android-core.mjs verify",
    "android:collect": "node scripts/android-build.mjs --collect",
    "android:install": "python3 scripts/android-install.py --launch",
    "test:ui": "node scripts/test-ui.mjs",
    "test:performance": "node scripts/test-performance.mjs",
    "package:verify": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "jsqr": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.33.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.11.3",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "playwright": "1.65.1",
    "typescript": "^5.9.0",
    "vite": "7.3.8"
  },
  "build": {
    "appId": "local.waarp",
    "productName": "Waarp",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "sing-box.exe",
          "libcronet.dll",
          "integrity.json",
          "LICENSE",
          "SOURCE.md",
          "CRONET-NOTICES.txt"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "node_modules/react/LICENSE",
        "to": "licenses/react/LICENSE"
      },
      {
        "from": "node_modules/react-dom/LICENSE",
        "to": "licenses/react-dom/LICENSE"
      },
      {
        "from": "node_modules/scheduler/LICENSE",
        "to": "licenses/scheduler/LICENSE"
      },
      {
        "from": "node_modules/jsqr/LICENSE",
        "to": "licenses/jsqr/LICENSE"
      },
      {
        "from": "node_modules/simple-icons/LICENSE.md",
        "to": "licenses/simple-icons/LICENSE.md"
      },
      {
        "from": "node_modules/@fontsource/inter/LICENSE",
        "to": "licenses/@fontsource/inter/LICENSE"
      },
      {
        "from": "node_modules/@fontsource-variable/instrument-sans/LICENSE",
        "to": "licenses/@fontsource-variable/instrument-sans/LICENSE"
      },
      {
        "from": "node_modules/@fontsource-variable/jetbrains-mono/LICENSE",
        "to": "licenses/@fontsource-variable/jetbrains-mono/LICENSE"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Waarp"
    },
    "portable": {
      "unpackDirName": true,
      "artifactName": "Waarp-${version}-portable.exe"
    }
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1",
    "undici@6": "6.29.1",
    "undici@7": "7.30.2",
    "fast-uri@3": "3.1.9"
  }
}
